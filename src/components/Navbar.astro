---
import { type Lang, routes } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { profile } from '../data';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'en' ? 'fr' : 'en';
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
const links = routes.map((r) => ({
  href: localizePath(r.path, lang),
  label: t(`nav.${r.key}`),
  active: isActive(r.path),
}));
const linkCls =
  'text-stone-700 no-underline hover:text-accent dark:text-slate-300 dark:hover:text-accent-dark';
---

<header class="border-b border-stone-200 dark:border-slate-800">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a
      href={localizePath('/', lang)}
      class="font-semibold whitespace-nowrap text-stone-900 no-underline dark:text-slate-100"
      >{profile.shortName}</a
    >

    <div class="flex items-center gap-3 text-sm">
      <ul class="hidden items-center gap-4 lg:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={l.active ? 'page' : undefined}
                class:list={[linkCls, l.active && 'font-medium text-stone-900 underline dark:text-slate-100']}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="hidden text-stone-300 lg:inline dark:text-slate-700" aria-hidden="true">|</span>
      <a
        href={localizePath(path, other)}
        hreflang={other}
        lang={other}
        title={t('lang.switch')}
        aria-label={t('lang.switch')}
        class="badge">{other.toUpperCase()}</a
      >
      <ThemeToggle label={t('theme.toggle')} />

      <details class="relative lg:hidden">
        <summary class="badge" aria-label={t('nav.menu')}>☰</summary>
        <ul
          class="absolute right-0 z-20 mt-2 w-44 rounded border border-stone-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900"
        >
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={l.active ? 'page' : undefined}
                  class:list={['block px-2 py-1', linkCls, l.active && 'font-medium underline']}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>
