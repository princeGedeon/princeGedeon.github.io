---
import { profile } from '../data';
import type { Lang } from '../i18n/ui';
import { formatMonth, useTranslations } from '../i18n/utils';
import SocialIcons from './SocialIcons.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const now = new Date();
const updated = formatMonth(
  `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}`,
  lang,
  'long',
);
---

<footer class="border-t border-stone-200 dark:border-slate-800">
  <div
    class="meta mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-4 py-5 sm:flex-row sm:px-6"
  >
    <p>© {now.getUTCFullYear()} {profile.name} · {t('footer.updated')}: {updated}</p>
    <SocialIcons lang={lang} />
  </div>
</footer>
