---
import '../styles/global.css';
import '../styles/pro.css';

import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import ProEffects from '../components/ProEffects.astro';
import Sidebar from '../components/Sidebar.astro';
import { profile } from '../data';
import { defaultLang, type Lang, languages } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Route path without language prefix, e.g. '/cv/'. */
  path: string;
  title?: string;
  description?: string;
  /** Hide the profile sidebar (e.g. 404). */
  sidebar?: boolean;
  /** Home only: render both layouts; `profile.homeLayout` picks the default, ?dev=1 previews the other. */
  switchable?: boolean;
}

const { lang, path, title, description, sidebar = true, switchable = false } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL('http://localhost');

const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name} — ${profile.headline[lang]}`;
const desc = description ?? profile.seeking[lang];
const canonical = new URL(localizePath(path, lang), site).href;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(localizePath(path, l), site).href,
}));
const xDefault = new URL(localizePath(path, defaultLang), site).href;
const photo = new URL(localizePath(profile.photo, defaultLang), site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline.en,
  description: profile.seeking.en,
  image: photo,
  url: new URL(localizePath('/', defaultLang), site).href,
  affiliation: { '@type': 'Organization', name: profile.affiliation.en },
  alumniOf: profile.seo.alumniOf.map((name) => ({ '@type': 'CollegeOrUniversity', name })),
  knowsAbout: profile.pillars.map((p) => p.en),
  sameAs: profile.socials.filter((s) => s.enabled && s.url).map((s) => s.url),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={profile.name} />
    {profile.seo.keywords.length > 0 && <meta name="keywords" content={profile.seo.keywords.join(', ')} />}
    {
      profile.seo.googleVerification && (
        <meta name="google-site-verification" content={profile.seo.googleVerification} />
      )
    }
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href={localizePath('/favicon.svg', defaultLang)} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={localizePath('/favicon.svg', defaultLang)} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={photo} />
    <meta property="og:image:alt" content={profile.name} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={photo} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => {
        // Light by default; dark only when the visitor picked it.
        const s = localStorage.getItem('theme');
        document.documentElement.dataset.theme = s === 'dark' ? 'dark' : 'light';
        // Experimental looks: ?pro=1 (AI / dev), ?pro=2 (afro design), ?pro=0 resets.
        const p = new URLSearchParams(location.search).get('pro');
        if (p === '1' || p === '2') sessionStorage.setItem('pro', p);
        if (p === '0') sessionStorage.removeItem('pro');
        const pro = sessionStorage.getItem('pro');
        if (pro) document.documentElement.dataset.pro = pro;
      })();
    </script>
    {
      switchable && (
        <script is:inline define:vars={{ layout: profile.homeLayout }}>
          const q = new URLSearchParams(location.search).get('dev');
          if (q === '1') sessionStorage.setItem('dev', '1');
          if (q === '0') sessionStorage.removeItem('dev');
          const dev = sessionStorage.getItem('dev') === '1';
          document.documentElement.dataset.layout = dev ? (layout === 'hero' ? 'sidebar' : 'hero') : layout;
        </script>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:px-2 dark:focus:bg-slate-900"
      >{t('skip')}</a
    >
    <Navbar lang={lang} path={path} />
    <div
      class:list={[
        'mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6',
        sidebar && 'md:grid md:grid-cols-[15rem_1fr] md:gap-10',
        switchable && 'home-grid',
      ]}
    >
      {sidebar && (switchable ? <div class="only-sidebar"><Sidebar lang={lang} /></div> : <Sidebar lang={lang} />)}
      <main id="main" class="min-w-0">
        {
          title && (
            <header class="mb-6">
              <h1 class="text-3xl">{title}</h1>
              {description && <p class="meta mt-1 text-sm">{description}</p>}
            </header>
          )
        }
        <slot />
      </main>
    </div>
    <Footer lang={lang} />
    <ProEffects />
  </body>
</html>
