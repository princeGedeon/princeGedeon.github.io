---
import PublicationItem from '../components/PublicationItem.astro';
import ResearchDiagram from '../components/ResearchDiagram.astro';
import SocialIcons from '../components/SocialIcons.astro';
import GradIcon from '~icons/fa-solid/graduation-cap';
import PinIcon from '~icons/fa-solid/map-marker-alt';
import { news, profile, projects } from '../data';
import type { Lang } from '../i18n/ui';
import { asset, available, formatMonth, localizePath, useTranslations } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import { publications } from '../lib/publications';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const selected = publications.filter((p) => p.selected);
const cvs = (['en', 'fr'] as const).filter((l) => available(profile.cv[l]));
const research = profile.research;
const thesis = projects.find((p) => p.featured);
---

<Base lang={lang} path="/" switchable>
  <h1 class="only-sidebar sr-only">{profile.name}</h1>
  <section class="only-hero mb-6 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8">
    {
      available(profile.photo) && (
        <img
          src={asset(profile.photo)}
          alt={profile.name}
          width="176"
          height="176"
          class="size-36 shrink-0 rounded-full border-2 border-gold/60 object-cover sm:size-44"
        />
      )
    }
    <div>
      <h1 class="text-3xl sm:text-4xl">{profile.name}</h1>
      <p class="mt-1 text-lg text-stone-700 dark:text-slate-300">{profile.headline[lang]}</p>
      <p class="meta mt-1 flex flex-wrap items-center gap-x-4 gap-y-1">
        <span class="inline-flex items-center gap-1.5">
          <GradIcon class="size-3.5" aria-hidden="true" />{profile.affiliation[lang]}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <PinIcon class="size-3.5" aria-hidden="true" />{profile.location[lang]}
        </span>
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <SocialIcons lang={lang} />
        {
          cvs.map((l) => (
            <a class="badge" href={asset(profile.cv[l])} download title={t('cv.download')}>
              CV · {l.toUpperCase()}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    profile.pro.terminal[lang] && (
      <p class="pro-only pro-terminal" data-typewriter={profile.pro.terminal[lang]} aria-hidden="true">
        <span data-typed />
      </p>
    )
  }
  <section class="prose-tight mt-6">
    {profile.bio[lang].map((para) => <p set:html={para} />)}
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t('home.interests')}>
      {profile.pillars.map((p) => <li class="tag">{p[lang]}</li>)}
    </ul>
  </section>

  {
    research && (
      <section class="mt-10" aria-labelledby="research-heading">
        <h2 id="research-heading" class="section-title">
          {research.heading[lang]}
        </h2>
        <blockquote class="research-question">{research.question[lang]}</blockquote>
        <div class="mt-6">
          <ResearchDiagram labels={research.diagram} lang={lang} />
        </div>
        <div class="prose-tight mt-6">
          {research.paragraphs[lang].map((para) => (
            <p set:html={para} />
          ))}
        </div>
      </section>
    )
  }

  {
    thesis && (
      <section class="mt-10">
        <h2 class="section-title">{t('home.featured')}</h2>
        <a href={localizePath(`/projects/#${thesis.id}`, lang)} class="featured-card">
          {available(thesis.figure) && (
            <img
              src={asset(thesis.figure)}
              alt={thesis.title[lang]}
              loading="lazy"
              width="797"
              height="236"
              class="w-full rounded-md border border-stone-200 dark:border-slate-700"
            />
          )}
          <p class="mt-3 font-serif text-lg leading-snug font-semibold text-stone-900 dark:text-slate-100">
            {thesis.title[lang]}
          </p>
          <p class="meta mt-0.5">{thesis.context[lang]}</p>
          <p class="mt-2 text-stone-700 dark:text-slate-300">{thesis.summary[lang]}</p>
        </a>
      </section>
    )
  }

  <section class="mt-10">
    <h2 class="section-title">{t('home.interests')}</h2>
    <ul class="grid list-disc gap-x-8 gap-y-1 pl-5 text-sm sm:grid-cols-2">
      {profile.researchInterests.map((i) => <li>{i[lang]}</li>)}
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="section-title">{t('home.news')}</h2>
    <ul class="space-y-2 text-sm">
      {
        news.map((n) => (
          <li class="grid gap-x-4 sm:grid-cols-[5.5rem_1fr]">
            <time class="meta pt-0.5" datetime={n.date}>
              {formatMonth(n.date, lang)}
            </time>
            <span set:html={n[lang]} />
          </li>
        ))
      }
    </ul>
  </section>

  {
    selected.length > 0 && (
      <section class="mt-8">
        <h2 class="section-title">{t('home.selected')}</h2>
        <ol class="space-y-5">
          {selected.map((pub) => (
            <PublicationItem pub={pub} lang={lang} />
          ))}
        </ol>
        <p class="mt-4 text-sm">
          <a href={localizePath('/publications/', lang)}>{t('home.allPubs')} →</a>
        </p>
      </section>
    )
  }
</Base>
