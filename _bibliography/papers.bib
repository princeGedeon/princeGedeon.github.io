@mastersthesis{guedje2026marl,
  title     = {Multi-Agent Reinforcement Learning for 3D Urban Environment Mapping under Energy and Communication Constraints},
  author    = {Guedje, Prince Gédéon},
  school    = {Université Clermont Auvergne},
  year      = {2026},
  abbr      = {M.Sc. Thesis},
  abstract  = {A team of three drones maps an unknown city in simulation. The mission is formulated as a constrained Dec-POMDP. The drones learn with MAPPO, share information with their neighbours through a graph attention layer, and merge their maps with multi-robot SLAM. Battery and storage limits are handled with Lagrangian penalties, and collisions, altitude limits and no-fly zones with a Control Barrier Function filter. The full pipeline runs in Gazebo and ROS 2.},
  pdf       = {/papers/thesis-summary-guedje-2026.pdf},
  selected  = {true}
}
